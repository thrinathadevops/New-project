# .env and ANY sidecar of it (.env.bak, .env.local, .env.backup ...).
# A plain `.env` line matches only that exact name, so a backup file
# would have been committable with every secret in it.
.env
.env.*
*.env.bak
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_temp/
.streamlit/secrets.toml
data/*.sqlite
data/*.db
# WAL journal mode (enabled in ledger/schema.py) writes these alongside
# the database; they hold the same trading data and must not be committed.
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db-wal
data/*.db-shm
data/test-advisor-*.sqlite

# Fetched event dates, refreshed daily. Generated, not authored: committing it
# would pin someone else's checkout to the results calendar of the day it was
# written.
data/event_calendar.json

# Logs can contain broker credentials. SmartAPI echoes the full POST body --
# clientcode, PIN and TOTP -- into its error logs on a failed login, so the
# whole directory is excluded, not just *.csv as before.
logs/
